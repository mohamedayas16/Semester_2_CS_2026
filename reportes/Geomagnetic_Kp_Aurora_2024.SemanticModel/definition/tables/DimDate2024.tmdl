	column 'NASA Storm Day' = ```
			
			IF(
			    COUNTROWS(RELATEDTABLE(NASAStormEvents)) > 0,
			    "NASA Storm Day",
			    "Other Day"
			)
			
			```
		lineageTag: 456a5cf1-3371-4bde-bc21-2189539bdf62
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Average Aurora Reports per Day' = ```
			
			AVERAGEX(
			    VALUES(DimDate2024[Date]),
			    COALESCE(
			        CALCULATE(
			            SUM(AuroraDaily[aurora_report_count])
			        ),
			        0
			    )
			)
			
			```
		lineageTag: ee3f7888-ab03-4bb1-ac8b-2843caa22538
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Daily Aurora Reports' = ```
			
			COALESCE(
			    LOOKUPVALUE(
			        AuroraDaily[aurora_report_count],
			        AuroraDaily[date], DimDate2024[Date]
			    ),
			    0
			)
			
			```
		formatString: 0
		lineageTag: 7e98dc34-0740-42a0-b7fc-66677930e735
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition DimDate2024 = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS(
				    CALENDAR(DATE(2024, 1, 1), DATE(2024, 12, 31)),
				    "Year", YEAR([Date]),
				    "MonthNumber", MONTH([Date]),
				    "MonthName", FORMAT([Date], "MMMM"),
				    "YearMonth", FORMAT([Date], "yyyy-MM")
				)
				
				```

	annotation PBI_Id = 284f1e5e42d745d9aa0e20ec6a863f85

