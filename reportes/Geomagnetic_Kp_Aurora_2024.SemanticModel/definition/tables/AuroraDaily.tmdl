table AuroraDaily
	lineageTag: 10ec54cd-0de6-4459-889b-9d9699b82575

	measure 'Average Kp 2024' = AVERAGE(FactKp2024[kp])
		lineageTag: d8412e33-2043-4211-8828-86ee8afaa676

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Maximum Kp 2024' = MAX(FactKp2024[kp])
		lineageTag: 5151ab57-9337-4435-8309-aca6562400e3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Storm Intervals 2024' =
			
			CALCULATE(
			    COUNTROWS(FactKp2024),
			    FactKp2024[kp] >= 5
			)
		formatString: 0
		lineageTag: 2ae014e7-b598-4460-a708-144c85110c20

	measure 'Aurora Reports 2024' =
			
			SUM(AuroraDaily[aurora_report_count])
		formatString: 0
		lineageTag: eae581e6-8fbd-4119-99a8-a62409d4314e

	measure 'Kp Observations 2024' =
			
			COUNTROWS(FactKp2024)
		formatString: 0
		lineageTag: 433b2968-7afa-481c-844a-c64ec9c79043

